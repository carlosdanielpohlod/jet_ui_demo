<%= jet_ui.card do %>
  <%= jet_ui.card_header do %>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
      <div style="display:flex;align-items:center;gap:10px">
        <%= jet_ui.avatar user: post[:author], size: 8 %>
        <div>
          <%= jet_ui.card_title post[:title] %>
          <p style="font-size:12px;color:var(--color-muted-foreground);margin-top:2px"><%= post[:author].full_name %></p>
        </div>
      </div>
      <span style="flex-shrink:0">
        <%= jet_ui.badge(post[:status], variant: post[:status] == "published" ? :success : :secondary) %>
      </span>
    </div>
  <% end %>
  <%= jet_ui.card_body do %>
    <p style="font-size:14px;color:var(--color-muted-foreground);line-height:1.6"><%= post[:body] %></p>
    <div style="margin-top:16px">
      <%= jet_ui.btn(variant: :outline, size: :sm) { "View post" } %>
    </div>
  <% end %>
<% end %>
