<% content_for :title, "New Post" %>

<%= jet_ui.card do %>
  <%= jet_ui.card_header do %>
    <%= jet_ui.card_title "New Post" %>
  <% end %>
  <%= jet_ui.card_body do %>
    <%= render "form", post: @post %>
    <div class="mt-4">
      <%= jet_ui.btn(variant: :ghost) { link_to "Back", posts_path } %>
    </div>
  <% end %>
<% end %>
