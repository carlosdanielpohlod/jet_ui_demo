<% content_for :title, @post.title %>

<%= jet_ui.card do %>
  <%= jet_ui.card_header do %>
    <div class="flex items-center justify-between">
      <%= jet_ui.card_title @post.title %>
      <%= jet_ui.badge(@post.status.presence || "draft", variant: @post.status == "published" ? :default : :secondary) %>
    </div>
  <% end %>
  <%= jet_ui.card_body do %>
    <p class="text-gray-700"><%= @post.body %></p>
  <% end %>
<% end %>

<div class="flex gap-2 mt-4">
  <%= jet_ui.btn(variant: :outline) { link_to "Edit", edit_post_path(@post) } %>
  <%= jet_ui.btn(variant: :ghost) { link_to "Back", posts_path } %>
  <%= button_to "Delete", @post, method: :delete,
      class: "text-sm text-red-500 hover:text-red-700 font-medium px-4 py-2 border border-red-200 rounded-md",
      data: { turbo_confirm: "Delete this post?" } %>
</div>
